// Boot placeholder ONLY. Deliberately deny-all and deliberately never tested.
//
// The emulator needs a rules file at startup and firebase.json cannot point
// outside its own directory. run.mjs then loads the REAL ../../firestore.rules
// into the test environment, which replaces this entirely. Keeping a deny-all
// here rather than a copy of the real rules means there is no stale snapshot
// that could silently be the thing under test.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
