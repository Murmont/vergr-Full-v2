# Non-secret string params for email verification (functions/emailVerification.js).
# The mailbox login lives in the SMTP_USER / SMTP_PASS SECRETS, not here.
# Override these only if Spacemail shows a different host/port.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_FROM=Vergr <noreply@vergr.app>
