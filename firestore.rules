rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Creator applications. Written only by the applyForCreator /
    // adminDecideCreatorApplication callables; a client must never be able to
    // approve itself. Readable by the applicant so they can see their status.
    match /creator_applications/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ============================================================
    // HELPER FUNCTIONS (now inside the match, so they can use $(database))
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    // Anonymous Firebase Auth users (guest mode). They ARE authenticated
    // — request.auth.uid is set — but the sign-in provider is "anonymous"
    // and they must not be allowed to write user-generated content,
    // posts, comments, squad data, etc. Read access is fine. Use
    // isRegistered() instead of isAuth() to require a real account.
    function isAnonymousAuth() {
      return isAuth() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegistered() {
      return isAuth() && !isAnonymousAuth();
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Registered + owner — the typical write requirement. Guests can
    // never satisfy this even with their own uid because they're not
    // registered.
    function isRegisteredOwner(userId) {
      return isRegistered() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isModerator() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function isSquadMember(squadId) {
      return isAuth() && exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid));
    }

    function isSquadAdmin(squadId) {
      return isAuth() && get(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid)).data.role in ['president', 'vice_president'];
    }

    function isSquadOwner(squadId) {
      return isAuth() && get(/databases/$(database)/documents/squads/$(squadId)).data.ownerId == request.auth.uid;
    }

    function validString(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }

    function isConversationParticipant(convoId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
    }

    // ============================================================
    // APP CONFIG
    // ============================================================

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // USERS
    // ============================================================

    // Username -> uid reservation index, maintained server-side by the
    // maintainUsernameIndex Cloud Function. Public read so vergr.me
    // (/u/:username) and the signup availability check can resolve handles;
    // writes are server-only (the Admin SDK bypasses these rules).
    match /usernames/{name} {
      allow read: if true;
      allow write: if false;
    }

    // Time-locked buy-and-send price quotes (functions/gemTransfer.js). Fully
    // server-side — a client that could read or write these could re-price its
    // own transfer, which is the one thing the lock exists to prevent. Default
    // deny already covers this; it is stated explicitly so nobody later opens
    // it up on the assumption the client needs access.
    match /gem_quotes/{quoteId} {
      allow read, write: if false;
    }

    // ── Equippable rank cosmetics ────────────────────────────────────
    // Mirrors the `equip: true` rows of src/utils/rankUnlocks.js. The client
    // hides options above your level, but a client gate is advisory: rules are
    // the boundary, so the level requirement is repeated here.
    //
    // Read against resource.data.vpLevel (the value ALREADY on the doc, written
    // only by the syncVpLevel trigger), never request.resource, or a caller
    // could raise their level and equip in the same write.
    //
    // KEEP IN SYNC with rankUnlocks.js. If you add a cosmetic there and not
    // here it will be rejected at write time, which is the safe direction.
    function cosmeticMinLevel(kind, id) {
      return kind == 'accent'
        ? ({ 'violet': 2, 'pink': 6, 'ember': 12, 'gold': 18, 'mint': 24,
            'azure': 33, 'rose': 44, 'onyx': 57, 'ruby': 68, 'aurora': 79,
            'mythic': 88, 'immortal': 100 }).get(id, 999)
        : kind == 'theme'
        ? ({ 'default': 1, 'deep': 6, 'grain': 16, 'beam': 27, 'carved': 38,
            'aurora': 52, 'eclipse': 66, 'nebula': 84 }).get(id, 999)
        : kind == 'nameEffect' ? 63
        : kind == 'nameFont'   ? 3
        : kind == 'nameColor'  ? 12
        : kind == 'audioClip'  ? 35
        : kind == 'typingStyle' ? 32
        : kind == 'ambiance'   ? 81
        // Effect 11. Mirrors the squad_environment / squad_weather rows in
        // rankUnlocks.js (Champion LV2 = 52, Legend LV3 = 73).
        : kind == 'squadEnvironment' ? 52
        : kind == 'squadWeather'     ? 73
        : 999;
    }

    // ⚠ THE CALLER'S OWN LEVEL, for unlocks that are written onto SOMEONE
    // ELSE'S document. Every cosmetic above lives on the user's own doc, so
    // `resource.data.vpLevel` is the right read there. A squad environment is
    // written onto the SQUAD doc, which has no vpLevel, so the setter's level
    // has to be fetched.
    //
    // ⚠ THIS IS A DOCUMENT READ, so it is billed. It is confined to the squad
    // update rule, which fires only when someone changes squad settings, not on
    // any hot path. Do NOT lift it into a broadly-applied helper.
    function myVpLevel() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('role', '') == 'admin' ? 100 : u.get('vpLevel', 1);
    }

    // Squad environments (effect 11). True for any write that is NOT setting an
    // environment, so it never restricts the existing squad-settings paths, and
    // true for an environment write only when the SETTER has earned the tier and
    // the id is one we actually ship.
    //
    // ⚠ Mirrors ENVIRONMENT_IDS in src/utils/squadEnvironments.js. Add an
    // environment there and here together, or the picker offers something the
    // server refuses — the same trap NAME_FONTS documents.
    //
    // ⚠ The level is the SETTER's, read from their own user doc. The unlock
    // belongs to a person; the room belongs to the squad. Every member sees it
    // whatever their own level, which is the entire point of a shared room.
    function envWriteOk() {
      return request.resource.data.get('chatBackground', '') != 'environment'
        || (
          request.resource.data.get('chatBackgroundValue', '') in
            ['nightfall', 'ember', 'frost', 'downpour', 'verdant', 'void']
          && cosmeticMinLevel('squadEnvironment', 'x') <= myVpLevel()
          && (request.resource.data.get('chatBackgroundWeather', false) != true
              || cosmeticMinLevel('squadWeather', 'x') <= myVpLevel())
        );
    }
    // A gradient stop is either absent or a plain 6-digit hex colour.
    function hexOrAbsent(m, k) {
      return m.get(k, null) == null
          || (m[k] is string && m[k].matches('^#[0-9a-fA-F]{6}$'));
    }
    // The stop LIST. Rules have no iteration, so this validates TYPE and SIZE
    // only.
    //
    // ⚠ PER-ITEM VALIDATION THEREFORE HAPPENS ON THE READ PATH, in
    // nameGradientFor() (src/utils/rankUnlocks.js), which hex-checks every stop
    // and DROPS any that fails. That is not a shortcut: a stop is interpolated
    // into a `linear-gradient()`, so it must be proven hex before it reaches
    // CSS, and the only place able to check each element is the reader. The size
    // cap here is what stops someone storing a huge array.
    function stopsOk(g) {
      return g.get('stops', null) == null
          || (g.stops is list && g.stops.size() >= 2 && g.stops.size() <= 6);
    }
    function cosmeticsAllowed() {
      let c = request.resource.data.get('cosmetics', {});
      // Admin sees the whole set so cosmetics can be judged without levelling
      // an account to 100. Read off the doc BEING WRITTEN, so it costs no
      // extra document read, unlike the isAdmin() helper above which does a get().
      let lvl = resource.data.get('role', '') == 'admin' ? 100 : resource.data.get('vpLevel', 1);
      // The animated name gradient. What is EARNED is the unlock (L63); the three
      // COLOURS are then the user's own free choice, so this validates SHAPE, not
      // entitlement.
      //
      // ⚠ Each value is interpolated into a `linear-gradient()` through a CSS
      // custom property, so it MUST be a plain 6-digit hex. A custom property can
      // carry arbitrary tokens, so an unvalidated string would rewrite the
      // gradient rather than colour it. The picker validates too, but the picker
      // is not the boundary — a direct Firestore write is.
      let g = c.get('nameGradient', {});
      return (c.get('accent', null) == null      || cosmeticMinLevel('accent', c.accent) <= lvl)
          && (c.get('theme', null) == null       || cosmeticMinLevel('theme', c.theme) <= lvl)
          && (c.get('nameEffect', false) != true || cosmeticMinLevel('nameEffect', 'x') <= lvl)
          && (c.get('audioClip', null) == null   || cosmeticMinLevel('audioClip', 'x') <= lvl)
          // Profile music (effect 09). Two shapes, both level-gated:
          //   { source: 'audius', trackId, title, artist, ... }  streamed from
          //     Audius, so Vergr stores metadata only and no URL of ours.
          //   { source: 'upload', url }  the owner's own file, and that URL IS
          //     handed to an <audio> element, so it is PINNED to our own CDN.
          //     Without the pin, a profile could point every visitor's browser
          //     at a third-party host of the owner's choosing. The report path
          //     covers CONTENT; this covers WHERE IT LOADS FROM, which a report
          //     cannot undo after the fact.
          //
          // ⚠ An Audius trackId is NOT a URL and must never be treated as one.
          // It is an opaque id the client turns into api.audius.co/...; nothing
          // the user writes here reaches the DOM as a src.
          && (c.get('profileAudio', null) == null
              || (cosmeticMinLevel('ambiance', 'x') <= lvl
                  && c.profileAudio.source in ['audius', 'upload']
                  && (c.profileAudio.source != 'upload'
                      || (c.profileAudio.get('url', '') is string
                          && c.profileAudio.url.matches('https://cdn[.]vergr[.]app/.*')))
                  && (c.profileAudio.source != 'audius'
                      || (c.profileAudio.get('trackId', '') is string
                          && c.profileAudio.trackId.size() > 0
                          && c.profileAudio.trackId.size() < 64))
                  // Denormalised display strings are shown to visitors, so they
                  // are length-capped rather than trusted.
                  && c.profileAudio.get('title', '').size() <= 200
                  && c.profileAudio.get('artist', '').size() <= 120))
          // The typeface is an ENUM, never a free string: an arbitrary value
          // would be an arbitrary webfont load on the busiest surface in the app.
          // MIRRORS `NAME_FONTS` in src/utils/nameFonts.js — add there and here
          // together, or the picker offers a face the server refuses to store.
          && (c.get('nameFont', null) == null || (
                cosmeticMinLevel('nameFont', 'x') <= lvl
             && c.nameFont in ['default', 'display', 'mono', 'orbitron', 'audiowide',
                               'russo', 'blackops', 'chakra', 'michroma', 'bungee',
                               'arcade', 'terminal', 'neon', 'faster', 'glitch',
                               'pixel', 'tourney', 'creep']
          ))
          // A FREE-HEX accent. The 12 presets stay level-gated by `accent`; this
          // is the picker's output and is gated on the same level as the highest
          // thing it could imitate would be pointless, so it is gated on the
          // ACCENT unlock itself (level 2, the first accent).
          && (c.get('accentHex', null) == null || (
                cosmeticMinLevel('accent', 'violet') <= lvl
             && hexOrAbsent(c, 'accentHex')
          ))
          && (c.get('nameColor', null) == null || (
                cosmeticMinLevel('nameColor', 'x') <= lvl
             && hexOrAbsent(c, 'nameColor')
          ))
          // The typing indicator style. An ENUM, mirroring TYPING_STYLES in
          // src/utils/rankUnlocks.js — add there and here together, or the
          // picker offers a style the server refuses to store.
          // `dots` is deliberately absent from the level gate's reach: it is
          // the default everybody already has, so storing it is how you turn
          // the cosmetic OFF and must work at any level.
          && (c.get('typingStyle', null) == null || c.typingStyle == 'dots' || (
                cosmeticMinLevel('typingStyle', 'x') <= lvl
             && c.typingStyle in ['dots', 'wave', 'bars', 'orbit', 'pixel', 'comet']
          ))
          && (c.get('nameGradient', null) == null || (
                cosmeticMinLevel('nameEffect', 'x') <= lvl
             && stopsOk(g)
             && hexOrAbsent(g, 'a') && hexOrAbsent(g, 'b') && hexOrAbsent(g, 'c')
          ));
    }

    match /users/{userId} {
      // PROFILE VISIBILITY IS ENFORCED HERE, not only on the screen.
      //
      // Settings → Privacy → "Who can see my profile" offers Everyone /
      // Friends & Followers / Only me. It was enforced inline in
      // PublicProfileScreen and NativeProfileScreens ONLY, so one
      // `getDoc(doc(db,'users',uid))` returned the full profile of someone who
      // had set "Only me" (audit A30). A privacy control the data layer ignores
      // is a control in name.
      //
      // `get` and `list` are DELIBERATELY SPLIT, and this is the crux:
      // a `resource.data` condition on a LIST is evaluated per returned
      // document and fails the WHOLE query if any single row fails. `users` is
      // bulk-queried all over the app (Explore reads 300, search, the
      // leaderboard's orderBy), so gating `read` would not have hidden one
      // profile — it would have broken Explore, search and the leaderboard
      // outright for everybody the moment one person chose "Only me".
      //
      // So: `get` (opening a profile) is gated, `list` (bulk) stays open.
      // Discovery surfaces already filter opted-out users client-side via
      // hiddenFromDiscovery + searchVis, which are separate controls.
      //
      // ⚠ Residual, stated plainly: a bulk query can still return the profile
      // FIELDS of a "Only me" user. Closing that needs the profile split into
      // public and private documents, which is a data migration, not a rule.
      // The genuinely sensitive fields have already been moved out (phone →
      // private/contact, KYC personal data → private/kyc).
      //
      // Cost: the follow lookups only run when profileVis is NOT 'Everyone',
      // because `||` short-circuits and 'Everyone' is the default. The common
      // path costs zero extra reads.
      allow get: if isOwner(userId)
        || resource.data.get('settings', {}).get('privacy', {}).get('profileVis', 'Everyone') == 'Everyone'
        || (isAuth() && (
              exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
              || exists(/databases/$(database)/documents/follows/$(userId + '_' + request.auth.uid))
           ));
      allow list: if true;
      allow create: if isOwner(userId)
        // Block self-referral on initial doc create
        && (!('referredBy' in request.resource.data) || request.resource.data.referredBy != userId);
      allow update: if (isOwner(userId) && (
          // referredBy is write-once: either it didn't exist before, or it's unchanged
          !('referredBy' in resource.data) || resource.data.referredBy == request.resource.data.get('referredBy', resource.data.referredBy)
        ) && (
          // Cannot self-refer
          !('referredBy' in request.resource.data) || request.resource.data.referredBy != userId
        ) && (
          // Server-only. `kycLevel` decides whether someone may become a creator
          // and be paid, `pendingCreatorCoins` is revenue received before the
          // creator agreement was accepted, `vp` is now minted only by the
          // claimCreatorQuest callable, and `creator` is the program status the
          // admin decision writes, and `kyc.verified` is what assertKycVerified
          // trusts. All five were owner-writable.
          // `vpLevel` joined them 2026-08-23: it is derived from wallets.vp by
          // the syncVpLevel trigger and it GATES REWARDS (the equippable
          // cosmetics below, the stream entry tier, the chat name colour), so an
          // owner-writable copy would be a one-line self-promotion to Immortal.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'kycLevel', 'kyc', 'pendingCreatorCoins', 'vp', 'creator', 'vpLevel',
            // Milestone counter. Badges are evaluated CLIENT-side (free, zero
            // reads), so the badge a visitor sees is only as honest as the
            // counter it reads. Owner-writable would make every badge a claim
            // rather than an achievement.
            'clipCount', 'streamMinutes',
            // VP bonus packs. Bought with COINS through the purchaseVpBonus
            // callable, or granted free by the ladder. Owner-writable would let
            // anyone stamp themselves a 3x VP multiplier with no expiry, which is
            // a one-line route to Immortal and to every reward it gates.
            'vpBonuses',
            // Paid Profile Boost. Same reasoning: the owner may write most of
            // their own doc, and a self-stamped boost is a free slot in the
            // suggested-users rail.
            'boostExpiresAt', 'boostedAt', 'boostBucket',
            // Delivery counters shown to the BUYER as proof the boost ran.
            'boostImpressions', 'boostViews', 'boostEngagements'
          ])
        ) && (
          cosmeticsAllowed()
        ))
        || isModerator()
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followingCount']));
      allow delete: if isAdmin();

      match /private/{docId} {
        // shopIntegration holds raw Shopify/Woo API tokens — CF-only (Admin SDK
        // bypasses rules). A specific match can't REVOKE a broad allow in
        // Firestore, so the exclusion lives here.
        //
        // lockedPostFiles / lockedMessageFiles hold the R2 object keys behind
        // paid content, and getAccess signs whatever key it finds in them. If a
        // creator could write here they would point their own cheap post at
        // SOMEONE ELSE'S locked object and sell access to content they do not
        // own, routing around the ownership check in createLockedPost. Owner
        // read is denied too: the keys are useless without a signature, and a
        // readable key is one screenshot away from being a support problem.
        //
        // mediaPackFiles is the same hazard in a different shape: it is the key
        // list a saved Content Pack sends from, so a writable copy would let a
        // creator point their own pack at another creator's private objects.
        allow read, write: if isOwner(userId)
          && docId != 'shopIntegration'
          && docId != 'lockedPostFiles'
          && docId != 'lockedMessageFiles'
          && docId != 'mediaPackFiles';
      }

      // Content Packs — a creator's saved, priced sets.
      //
      // Owner-readable so the picker can list them without a callable round
      // trip, and CALLABLE-ONLY for writes: `createMediaPack` is what proves the
      // named objects belong to this creator, and a client-writable pack
      // document would make that check optional. The document holds blurred
      // previews and a price, never an object key.
      match /mediaPacks/{packId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /game_accounts/{accountId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /bookmarks/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Client analytics events (trackEvent). Owner-only create/read; never
      // updated or deleted from the client.
      match /events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Privacy/consent docs (consent banners, captureSignals telemetry).
      // Owner read/write; admins can read for support. Server (Cloud Functions)
      // bypasses these rules anyway via the admin SDK.
      match /meta/{docId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Saved crypto wallet addresses for fast payouts.
      match /savedAddresses/{addrId} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // vergr.me (Linktree-style) page config.
      //
      // `page` is world-read so /u/:username renders for anyone, including
      // logged-out visitors. `draft` is NOT: it holds unpublished edits, and
      // the whole point of a Publish button is that nothing is public until it
      // is pressed.
      //
      // The draft used to be a FIELD on the public `page` doc, so anyone could
      // read `users/{uid}/vergrMe/page` and see every unpublished change as it
      // was typed (audit A30). It now lives in its own document, which is the
      // only way to make it private: Firestore rules gate documents, never
      // fields.
      match /vergrMe/{docId} {
        allow read:  if docId != 'draft' || isOwner(userId);
        allow write: if isOwner(userId);
      }

      // vergr.me view/click analytics. Owner (+admin) reads. Writes are
      // SERVER-ONLY (trackVergrMeEvent CF via Admin SDK) so logged-out
      // visitors are counted without opening the doc to client tampering.
      match /vergrMeViews/{docId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      // vergr.me email-collect leads. Public (incl. logged-out) visitors may
      // submit an email via the page pop-up; only the owner/admin can read them.
      match /vergrMeLeads/{leadId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow create: if request.resource.data.email is string
                      && request.resource.data.email.size() > 3
                      && request.resource.data.email.size() < 200;
        allow update, delete: if false;
      }

      // vergr.me digital product catalog. World-read so the public page can
      // list products (incl. logged-out); owner writes. The paid FILE's R2 key
      // is deliberately NOT on this doc (it lives in the owner-only
      // private/vergrMeProductFiles map; the download CF reads it server-side)
      // so a world-readable listing can never leak the paywalled object.
      match /vergrMeProducts/{productId} {
        allow read:  if true;
        allow write: if isOwner(userId);
      }
    }

    // ============================================================
    // FOLLOWS
    // ============================================================

    match /follows/{followId} {
      allow read: if true;
      // Guests (anonymous auth) cannot follow — must be a registered user.
      allow create: if isRegistered() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isRegistered() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ============================================================
    // POSTS
    // ============================================================

    match /posts/{postId} {
      allow read: if true;
      // Posting requires a registered account, never a guest.
      allow create: if isRegistered()
        && request.resource.data.authorId == request.auth.uid
        && validString('content', 5000);
      // Author/moderator can edit the post freely. Any authenticated user may
      // touch ONLY the engagement counters (like/comment/save/share/view) so
      // that toggleLike/toggleBookmark/repost/impression batches — which bump a
      // counter on the post doc alongside writing their own like/save subdoc —
      // are not denied. The subcollection rules still gate who can actually
      // create a like/save, so this can't be used to forge engagement records.
      // ⚠ `boostExpiresAt` is SERVER-ONLY. The author branch above grants write
      // on ANY field, so without this a user could stamp their own post with a
      // boost and take the paid 3x For You multiplier for free. Written only by
      // purchaseBoost, after it has debited the coins.
      allow update: if ((isRegisteredOwner(resource.data.authorId) || isModerator())
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['boostExpiresAt', 'boostedAt', 'boostImpressions', 'boostViews', 'boostEngagements']))
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys()
              // ⚠ `viewCount` REMOVED from this allowlist 2026-08-28. It let any
              // signed-in user write any post's view count — including someone
              // else's. Nothing displayed it (incrementViewCount had zero callers),
              // but Creator Studio already SORTS and TOTALS by it, and a visible
              // number that anyone can inflate is worse than no number at all.
              // Counting is server-side from now on: docs/BOOST_DELIVERY_PLAN.md §6.
              .hasOnly(['likeCount', 'commentCount', 'saveCount', 'shareCount', 'repostCount']));
      allow delete: if isRegisteredOwner(resource.data.authorId) || isModerator();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isRegistered()
          && request.resource.data.authorId == request.auth.uid
          && validString('content', 2000);
        // Author/mod edit freely; any auth user may touch ONLY likeCount so a
        // comment-like batch (marker subdoc + counter bump) isn't denied. The
        // likes subcollection below still gates who can create a like record.
        allow update: if isRegisteredOwner(resource.data.authorId) || isModerator()
          || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']));
        allow delete: if isRegisteredOwner(resource.data.authorId) || isModerator();

        match /likes/{userId} {
          allow read: if true;
          allow create: if isRegisteredOwner(userId);
          allow delete: if isRegisteredOwner(userId);
          allow update: if false;
        }
      }

      match /likes/{userId} {
        allow read: if true;
        allow create: if isRegisteredOwner(userId);
        allow delete: if isRegisteredOwner(userId);
        allow update: if false;
      }

      match /saves/{userId} {
        allow read: if isOwner(userId);
        allow create: if isRegisteredOwner(userId);
        allow delete: if isRegisteredOwner(userId);
      }
    }

    // Collection-group query support. The nested posts/{postId}/likes rule above
    // does NOT authorize a collectionGroup('likes') query (Firestore evaluates
    // those against a rule that matches the group itself). getLikedPosts runs
    // collectionGroup('likes').where('userId','==',uid), so allow a user to read
    // their own like docs across all posts. Without this the query is denied
    // with "Missing or insufficient permissions".
    match /{path=**}/likes/{likeId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // POLLS
    // ============================================================

    match /polls/{pollId} {
      allow read: if true;
      allow create: if isRegistered();

      match /votes/{userId} {
        allow read: if true;
        allow create: if isRegisteredOwner(userId);
      }
    }

    // ============================================================
    // STORIES
    // ============================================================

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      match /viewers/{viewerId} {
        allow read: if isOwner(resource.parent.data.authorId);
        allow create: if isAuth() && request.auth.uid == viewerId;
      }
    }

    // ============================================================
    // SQUADS
    // ============================================================

    match /squads/{squadId} {
      allow read: if true;
      allow create: if isRegistered();

      // ⚠ `envWriteOk()` is AND-ed onto the privileged branches, NOT added as a
      // separate `allow update`. Rules OR their allow clauses, so a second
      // clause could only ever GRANT access — a gate written that way gates
      // nothing, which is the same defect as the three inert kill switches.
      // ⚠ `boostExpiresAt` is SERVER-ONLY here too — a squad admin may write every
      // other field, and a self-stamped boost is a free slot in Explore.
      allow update: if ((isSquadAdmin(squadId) || isModerator()) && envWriteOk()
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['boostExpiresAt', 'boostedAt', 'boostImpressions', 'boostViews', 'boostEngagements'])) || (
        get(/databases/$(database)/documents/squads/$(squadId)).data.isPublic == true &&
        request.auth.uid != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt']) &&
        request.auth.uid in request.resource.data.memberIds
      ) || (
        // Any squad member may stamp ONLY the chat-activity fields (used by the
        // side-nav unread badge). Nothing sensitive is writable here.
        isSquadMember(squadId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageSenderId'])
      );
      allow delete: if isSquadOwner(squadId) || isAdmin();

      // These three rules used to chain into a coin mint. `create` let ANY
      // signed-in user write their own member doc in ANY squad with no field
      // validation, so they could write role:'president'; isSquadAdmin() reads
      // `role` off that very doc, so it then returned true; and the treasury
      // below was writable by any member. distributeVanguardTreasury pays that
      // balance out as real spendable coins.
      match /members/{memberId} {
        allow read: if true;
        allow create: if isAuth() && (
          isSquadAdmin(squadId)
          // The squad creator seeding their own president doc at createSquad
          // time, when no member doc exists yet so isSquadAdmin is still false.
          || isSquadOwner(squadId)
          // Self-join. Only your own doc, only as a plain member, and only into
          // a PUBLIC squad — private squads go through join_requests, which is
          // already gated correctly. isRegistered, not isAuth: squad data is
          // UGC and guests are excluded from it by the project's own rule.
          || (isRegistered() && request.auth.uid == memberId
              && request.resource.data.role == 'member'
              && get(/databases/$(database)/documents/squads/$(squadId)).data.get('isPublic', false) == true)
        );
        // Role is admin-only, or self-promotion to president is one write away.
        // Mute fields ride the same list so a muted member cannot unmute
        // themselves. No client path self-updates a member doc today
        // (joinSquad creates, leaveSquad deletes, role/mute are admin actions),
        // so the self branch only exists to keep cosmetic fields writable.
        allow update: if isAuth() && (
          isSquadAdmin(squadId)
          || (request.auth.uid == memberId
              && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['role', 'mutedUntil', 'muteReason']))
        );
        allow delete: if isAuth() && (request.auth.uid == memberId || isSquadAdmin(squadId));
      }

      match /messages/{messageId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isSquadMember(squadId);
        allow delete: if isAuth() && (resource.data.senderId == request.auth.uid || isSquadAdmin(squadId));
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, delete: if isSquadAdmin(squadId);
        // Squad members can update ONLY the attendees array (their own RSVP).
        // Admins can update everything.
        allow update: if isSquadAdmin(squadId) || (
          isSquadMember(squadId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])
        );
      }

      match /challenges/{challengeId} {
        allow read: if isSquadMember(squadId);
        allow create, delete: if isSquadAdmin(squadId);
        // Squad members can update ONLY their own progress entry. Admins can
        // update everything (mark complete, edit goal, etc.).
        allow update: if isSquadAdmin(squadId) || (
          isSquadMember(squadId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress'])
        );
      }

      match /media/{mediaId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId) && request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if isOwner(resource.data.uploadedBy) || isSquadAdmin(squadId);
      }

      match /join_requests/{requestId} {
        allow read: if isSquadAdmin(squadId);
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update: if isSquadAdmin(squadId);
        allow delete: if isSquadAdmin(squadId) || isOwner(resource.data.userId);
      }

      match /pinned/{pinnedId} {
        allow read: if isSquadMember(squadId);
        allow write: if isSquadAdmin(squadId);
      }

      // Squad polls and the kick/election votes. This was isAuth() with a
      // "(for debugging)" comment, i.e. any signed-in account — a guest, or
      // someone who has never been near the squad — could create AND overwrite
      // ballots in every squad on the platform.
      //
      // One doc per POLL (auto-id), not one per voter, so the voter is
      // identified by the `voterIds` array rather than the doc id. Casting is
      // the only legitimate update: your own uid joins voterIds and the tallies
      // move, nothing else. Refusing the write when you are already in
      // voterIds makes one-ballot-per-member structural instead of something
      // the client is trusted about (castSquadVote checks it, VotePollCard
      // does not).
      match /votes/{voteId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSquadMember(squadId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['voteCounts', 'voterIds', 'totalVotes'])
          && (request.auth.uid in request.resource.data.voterIds)
          && !(request.auth.uid in resource.data.get('voterIds', []));
        allow delete: if false;
      }

      // ✅ Vote intents for /vote command
      match /vote_intents/{userId} {
        allow read: if isSquadMember(squadId);
        allow create, update, delete: if isAuth() && request.auth.uid == userId && isSquadMember(squadId);
      }

      // THE SQUAD TREASURY. `wallet/main.balance` is what contributeToSquad,
      // vanguard.js and squadChallenges.js move, and what
      // distributeVanguardTreasury pays out as spendable coins. It is
      // server-only: nothing in src/ writes it (firestore.js:2064 and :2468 are
      // getDoc), and contributeToSquad moved into walletActions.js in the
      // 2026-08-16 server-only-money pass — this rule was never tightened to
      // match, which is the gap.
      //
      // The trailing `allow write: if false` this replaces was INERT. Firestore
      // allow statements are OR'd, never AND'd, so a later false cannot revoke
      // an earlier grant. It read as a lock and was not one.
      match /wallet/{docId} {
        allow read: if isSquadMember(squadId);
        allow write: if false;
      }

      // Server-only for the same reason: a forgeable ledger can be made to
      // corroborate a tampered treasury. Only read from src/ (firestore.js:2079).
      match /transactions/{txId} {
        allow read: if isSquadMember(squadId);
        allow write: if false;
      }

      match /announcements/{annId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadAdmin(squadId);
        allow update: if isSquadAdmin(squadId);
        allow delete: if isSquadAdmin(squadId);
      }
    }

    // ============================================================
    // VANGUARD  (moderator program)
    // Spec: CLAUDE.md → "Vanguard moderator program — LOCKED SPEC".
    // The rank itself lives on `users/{uid}.vanguard.rank` — those rules
    // are inherited from the existing /users/{uid} match. Only server-side
    // Cloud Functions can set/change the vanguard field (callables run
    // with admin SDK). Below are the rules for the dedicated collections.
    // ============================================================

    function isVanguardMember() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vanguard.rank in ['recruit', 'vanguard', 'senior', 'commander', 'overseer'];
    }
    function vanguardRankAtLeast(orderLevel) {
      // orderLevel: 1=recruit, 2=vanguard, 3=senior, 4=commander, 5=overseer
      let rank = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vanguard.rank;
      return isAuth() && (
        (rank == 'recruit'   && orderLevel <= 1) ||
        (rank == 'vanguard'  && orderLevel <= 2) ||
        (rank == 'senior'    && orderLevel <= 3) ||
        (rank == 'commander' && orderLevel <= 4) ||
        (rank == 'overseer'  && orderLevel <= 5)
      );
    }

    match /vanguard_invitations/{invitationId} {
      // Invitee sees their own; admin (founder) sees all; Commander+ sees all.
      allow read: if isAuth() && (
        resource.data.inviteeId == request.auth.uid ||
        isAdmin() ||
        vanguardRankAtLeast(4)
      );
      // Only server-side callables create / update / delete these.
      // (Cloud Functions use admin SDK and bypass these rules.)
      allow create, update, delete: if false;
    }

    match /vanguard_actions/{actionId} {
      // The moderator who took the action can read their own.
      // Commander+ can read all (audit log).
      // Founder can read all.
      allow read: if isAuth() && (
        resource.data.moderatorId == request.auth.uid ||
        isAdmin() ||
        vanguardRankAtLeast(4)
      );
      // Only server-side callables write actions. Client cannot fabricate
      // audit entries.
      allow create, update, delete: if false;
    }

    match /vanguard_payouts/{payoutId} {
      // All Vanguard members can read payout records.
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      allow create, update, delete: if false;
    }

    // ── Vanguard collaboration tools (client-written, gated to members) ──────
    // These are working tools the Vanguard uses directly (no Cloud Function in
    // the path), so writes are allowed from members with author-stamp checks.
    // The Vanguard is a small, founder-invited, trusted group.

    // Shared watchlist / case notes. Any member writes their own; Commander+
    // (or the author) can edit or delete.
    match /vanguard_notes/{noteId} {
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      allow create: if (isVanguardMember() || isAdmin()) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || vanguardRankAtLeast(4) ||
        (isVanguardMember() && resource.data.authorId == request.auth.uid);
    }

    // Case escalations up the chain. Any member opens one; the author or a
    // Senior+ can resolve it.
    match /vanguard_escalations/{escId} {
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      allow create: if (isVanguardMember() || isAdmin()) && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || vanguardRankAtLeast(3) ||
        (isVanguardMember() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || vanguardRankAtLeast(4) ||
        (isVanguardMember() && resource.data.authorId == request.auth.uid);
    }

    // Announcements — read by all members, authored only by Overseers + founder.
    match /vanguard_announcements/{annId} {
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      allow create: if (isAdmin() || vanguardRankAtLeast(5)) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || vanguardRankAtLeast(5);
    }

    // Decision Library — documented precedents. Any member contributes; author
    // or Commander+ can remove.
    match /vanguard_precedents/{precId} {
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      allow create: if (isVanguardMember() || isAdmin()) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || vanguardRankAtLeast(4) ||
        (isVanguardMember() && resource.data.authorId == request.auth.uid);
    }

    // Cheat signature registry — admin manages via /admin/cheat-signatures
    // (`upsertCheatSignature` / `deleteCheatSignature` / `adminSeedCheatSignatures`
    // callables). Read needed so the admin screen can render the list.
    // Active signatures are also read by `submitAntiCheatScan` server-side
    // via admin SDK, which bypasses these rules.
    match /cheat_signatures/{sigId} {
      allow read: if isAdmin();
      // Writes go through Cloud Functions only — the callables enforce
      // admin auth + schema validation. Client cannot edit directly.
      allow create, update, delete: if false;
    }

    // Anti-cheat alerts + scans — Vanguard mods read via the queue screen,
    // founder reads all. Created by `submitAntiCheatScan` server-side.
    match /anti_cheat_alerts/{alertId} {
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      allow create, update, delete: if false;
    }
    match /anti_cheat_scans/{scanId} {
      // A player can read their own scan (transparency). Mods read all.
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid ||
        isVanguardMember() ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================================
    // ADMIN AUDIT LOG  (append-only, server-written)
    // ============================================================
    // Every privileged admin callable writes a row here. Used for forensics
    // and to drive the real-time alert pipeline (Firestore trigger fans out
    // push notifications to every admin on create).
    match /admin_actions/{actionId} {
      // Only admins see the log. Cross-checked by Cloud Functions for
      // anomaly detection too (server-side reads bypass these rules).
      allow read: if isAdmin();
      // Append-only from clients. All writes go through Cloud Functions
      // with the admin SDK, which bypasses these rules.
      allow create, update, delete: if false;
    }

    // ============================================================
    // CLIENT ERROR TELEMETRY (I4) — silent-failure capture
    // ============================================================
    // Any signed-in client may APPEND an error report (capped + deduped
    // client-side). Only admins read; nobody edits/deletes from the client.
    match /client_errors/{errId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ============================================================
    // ADMIN SECURITY  (TOTP secrets — server-only)
    // ============================================================
    // Holds the confirmed TOTP secret + backup codes + enrolled-at timestamp
    // for every admin user. NEVER readable from the client; only the
    // verifyAdminTotp callable reads this doc. The lightweight public flag
    // showing "is enrolled?" + "last step-up time" lives on users/{uid}
    // (fields: mfaEnrolledAt, adminStepUpAt) — those propagate to the client.
    match /admin_security/{uid} {
      allow read, write: if false;
    }

    // Twitch mirror secrets — holds the user's Twitch stream key + OAuth tokens
    // so the Hetzner relay (re-push to Twitch) + vergr-chat IRC bridge can read
    // them via the Admin SDK. NEVER readable/writable by clients (the key would
    // let anyone hijack the user's Twitch broadcast). Written only by oauth.js.
    match /twitch_mirror_secrets/{uid} {
      allow read, write: if false;
    }

    // Pending TOTP enrollments (intermediate state between enroll + confirm).
    // Server-only. Auto-expires after 10 min via a scheduled cleanup.
    match /admin_totp_enrollment/{uid} {
      allow read, write: if false;
    }

    // Account-level 2FA (Settings → Security). Holds the user's TOTP secret +
    // hashed recovery codes. NEVER client-readable — only the account*Totp
    // callables (Admin SDK) touch it. The non-secret "is 2FA on?" flag lives at
    // users/{uid}.settings.twoFactorEnabled for the UI.
    match /account_security/{uid} {
      allow read, write: if false;
    }
    match /account_totp_enrollment/{uid} {
      allow read, write: if false;
    }

    // ============================================================
    // ADMIN ACCESS  (founder-invited sub-admins, per-screen scopes)
    // ============================================================
    // admin_users/{uid} — active sub-admin record. The user is allowed to
    // READ their own record so the client can decide which sidebar screens
    // to render. The founder reads everyone's record (via the listAdmins
    // callable, which uses the admin SDK and bypasses these rules).
    match /admin_users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if false;
    }

    // admin_invites/{id} — pending/accepted/revoked invitations. Founder
    // reads through listAdmins. An invitee can read their own invite by id
    // to look up the email match. Writes are server-only.
    match /admin_invites/{inviteId} {
      allow read: if isAdmin() ||
                     (isAuth() && resource.data.email == request.auth.token.email);
      allow create, update, delete: if false;
    }

    // ============================================================
    // TOURNAMENT ASSIGNMENTS  (claim-based mod scheduling)
    // ============================================================
    match /tournament_assignments/{assignmentId} {
      // All Vanguard members + admins can read every assignment (browse open
      // slots, see what others claimed, audit). Anyone can read the doc for
      // the tournament they're hosting too — but enforcing that requires a
      // get() on the tournament doc, which costs reads. Skip for now;
      // assignment data is non-sensitive (no PII).
      allow read: if isAuth() && (isVanguardMember() || isAdmin());
      // Writes are server-only (callables + triggers + crons).
      allow create, update, delete: if false;
    }

    // ============================================================
    // DAILY METRICS ROLLUP  (admin dashboard charts)
    // ============================================================
    // daily_metrics/{YYYY-MM-DD} — nightly rollup of signups + new
    // subs + platform revenue. Read only via the admin chart callable
    // (which uses the Admin SDK and bypasses rules). Clients shouldn't
    // need direct read — admin-only fallback so a curious admin in the
    // Firestore console isn't blocked.
    match /daily_metrics/{day} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================================
    // APPEALS  (user-submitted appeals on moderation actions)
    // ============================================================
    // appeals/{auto} — user creates via the submitAppeal callable (which
    // enforces dedupe + min-length + admin-set-fields). User can READ
    // their own appeals so the UI can show status. Updates + deletes are
    // server-only (admins resolve via adminResolveAppeal).
    match /appeals/{appealId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================================
    // TOURNAMENT ANNOUNCEMENTS  (admin-broadcast messages)
    // ============================================================
    // Public read — broadcast announcements are visible to anyone who
    // can see the tournament. Server-only writes (via the admin callable).
    match /tournament_announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ============================================================
    // SUBSCRIPTION PLANS  (admin-managed catalog)
    // ============================================================
    // plans/{planId} — readable by anyone (powers the subscription
    // screen + future public pricing pages). All writes are server-only
    // via the adminSubscriptions callables.
    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ============================================================
    // SUBSCRIPTION OVERRIDES  (comps + per-user discounts)
    // ============================================================
    // subscription_overrides/{id} — readable by the affected user OR
    // an admin. Writes are server-only (the adminCompUser /
    // adminApplyOverride / adminRevokeOverride callables).
    match /subscription_overrides/{overrideId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================================
    // SQUAD INVITATIONS  (root collection — leader-initiated)
    // ============================================================
    match /squad_invitations/{invitationId} {
      // Invitee or inviter can read their own. (Squad admins can read all
      // pending invites for their squad — needed for "outstanding invites"
      // admin view; not yet wired but cheap to allow.)
      allow read: if isAuth() && (
        request.auth.uid == resource.data.inviteeId ||
        request.auth.uid == resource.data.inviterId ||
        isSquadAdmin(resource.data.squadId)
      );
      // Only a squad admin can create an invitation, and inviterId must be
      // the caller. Validates the existence/shape of the basics.
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.inviterId
        && isSquadAdmin(request.resource.data.squadId)
        && request.resource.data.status == 'pending'
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId.size() > 0;
      // Invitee can update status to 'accepted' or 'declined'.
      // Inviter can update status to 'cancelled'.
      // Nobody can change the squadId / inviteeId / inviterId after creation.
      allow update: if isAuth() && (
        (
          request.auth.uid == resource.data.inviteeId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
          request.resource.data.status in ['accepted', 'declined']
        ) || (
          request.auth.uid == resource.data.inviterId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
          request.resource.data.status == 'cancelled'
        )
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.inviterId;
    }

    // ============================================================
    // GROUP INVITE CODES
    // ============================================================
    // Doc id IS the code (random, unguessable). Holding a live code is what
    // lets you join; deleting the doc revokes every link that carried it.
    //
    // `list` is FORBIDDEN on purpose: if you could query this collection you
    // could enumerate codes (or look one up by chatId) and walk straight past a
    // revoke. Get-by-exact-id only.
    match /group_invites/{code} {
      function convoOf(chatId) { return get(/databases/$(database)/documents/conversations/$(chatId)).data; }
      function isAdminOf(chatId) {
        return isAuth() && (
          request.auth.uid in convoOf(chatId).admins
          || convoOf(chatId).createdBy == request.auth.uid
        );
      }
      allow get: if isAuth();
      allow list: if false;
      allow create: if isAdminOf(request.resource.data.chatId);
      allow delete: if isAdminOf(resource.data.chatId);
      allow update: if false;   // rotate = delete + create, never mutate
    }

    // ============================================================
    // CONVERSATIONS (DIRECT MESSAGES)
    // ============================================================

    // Chat-theme write guard. Either the theme fields are untouched, or the
    // theme is cleared, or it is a known id credited to the writer themselves.
    // MIRRORS `CHAT_THEMES` in src/utils/chatThemes.js — add an id there and
    // here together, or the picker offers what the server refuses.
    function chatThemeWriterIsSelf() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['chatTheme', 'chatThemeBy', 'chatThemeColors', 'chatThemeMotion'])
          || (
            (request.resource.data.get('chatTheme', null) == null
             || (request.resource.data.chatTheme in ['arcade', 'dracula', 'gaia', 'chatter',
                                                   'cosmos', 'neon', 'vault', 'studio']
                 && request.resource.data.get('chatThemeBy', '') == request.auth.uid))
            // Custom colours: SIZE only. Rules have no iteration, so each value
            // is proven hex on the READ path (chatThemeCustomColors), which is
            // the same split the name gradient uses — the values end up in
            // canvas pixels, so they must be validated somewhere that can see
            // each one. This cap is what stops a huge array being stored.
            && (request.resource.data.get('chatThemeColors', null) == null
                || (request.resource.data.chatThemeColors is list
                    && request.resource.data.chatThemeColors.size() >= 3
                    && request.resource.data.chatThemeColors.size() <= 4))
            // Movement preset. MIRRORS CHAT_MOTIONS in src/utils/chatThemes.js.
            && (request.resource.data.get('chatThemeMotion', null) == null
                || request.resource.data.chatThemeMotion in ['drift', 'tide', 'pulse', 'wander', 'orbit'])
          );
    }

    match /conversations/{convoId} {
      // `get` used to be a bare isAuth(), which leaked the newest message of
      // EVERY thread on the platform: the doc carries `lastMessage` as the full
      // message BODY (firestore.js sendMessage), and the ids are derivable —
      // a DM is the two uids sorted and joined with '_', a support thread is
      // the literal `support_<channelId>_<uid>`, and uids are enumerable
      // because /users is world-read. Confirmed live 2026-08-18: a real account
      // read a DM it was not part of.
      //
      // It cannot simply become participants-only. A NON-participant legitimately
      // reads a group's doc on the invite landing page (`getGroupForJoin`,
      // firestore.js:3202) to show its name before joining, and the self-join
      // rule below depends on that flow. That applies to PRIVATE groups too:
      // they show the same preview, then go through joinRequests.
      //
      // So: participants always; group previews stay open EXCEPT support
      // threads, which are groups (supportChannel.js sets isGroup + a private
      // visibility) but whose ids are guessable. Group ids are addDoc auto-ids,
      // so a group preview already requires an unguessable id — the same bar
      // the invite code itself sits behind.
      allow get: if isAuth() && (
        request.auth.uid in resource.data.participants
        || (resource.data.isGroup == true
            && resource.data.get('supportThread', false) != true)
      );
      allow list: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      // Group-management fields (name/icon/admins/membership) are ADMIN-only
      // (creator implicit). Everything else (unread, readAt, mute, pin,
      // archive, lastMessage*, status, wallpaper...) stays open to any
      // participant. Self-leave (removing only yourself) is always allowed.
      // `ttlSeconds` (disappearing messages) rides this same list: in a GROUP
      // only an admin/creator may arm the timer; in a 1:1 DM either party may
      // (isGroup != true short-circuits below), which is the Telegram model.
      allow update: if isAuth() && request.auth.uid in resource.data.participants
        // ── CHAT THEME (effect 12) ────────────────────────────────────
        // Rules enforce IDENTITY; the read path enforces ENTITLEMENT. Neither
        // costs a document read.
        //
        // Whether you may use themes depends on your vpLevel or your Pro plan,
        // and checking that here would mean get()-ing your user doc on every
        // conversation write. Instead every viewer resolves the theme from the
        // SETTER's profile at render time (chatThemeFor), against fields that
        // are server-written and server-only.
        //
        // ⚠ That only holds if you cannot claim to BE somebody else. Without
        // this clause a free account could write chatThemeBy = <some Pro user>
        // and get the theme anyway. So: you may only name yourself.
        && chatThemeWriterIsSelf()
        && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['groupName', 'groupIcon', 'admins', 'participants', 'onlyAdminsPost', 'ttlSeconds',
                   'permissions', 'banned', 'requireInvite'])
        || resource.data.isGroup != true
        || resource.data.createdBy == request.auth.uid
        || (resource.data.admins != null && request.auth.uid in resource.data.admins)
        || (
          // self-leave: membership fields only, and you are no longer in it
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participants', 'admins', 'lastMessageAt', 'lastMessageText', 'lastMessage'])
          && !(request.auth.uid in request.resource.data.participants)
        )
      );
      // Public-group self-join: a signed-in NON-member may add ONLY their own
      // uid (plus their own metadata/unread seed) to a group whose visibility
      // is 'public'. Without this, the base update rule above (which requires
      // you to ALREADY be a participant) makes self-join impossible — that was
      // the "you don't have permission to view it" invite bug. Private groups
      // are excluded here; they go through joinRequests + admin approval below.
      //
      // Two extra gates on top of that (2026-07-14):
      //  - banned users can never self-join.
      //  - once an admin has issued an invite code (`requireInvite`), the joiner
      //    must PRESENT that code (in their own metadata entry) and it must
      //    resolve to THIS group. Revoking = deleting the group_invites doc, at
      //    which point every old link stops working. The code deliberately does
      //    NOT live on the conversation doc: `allow get` above is open to any
      //    signed-in user, so anyone holding the chatId could simply read the
      //    current code and revocation would be theatre.
      allow update: if isAuth()
        && resource.data.isGroup == true
        && resource.data.get('visibility', 'private') == 'public'
        && !(request.auth.uid in resource.data.participants)
        && !(request.auth.uid in resource.data.get('banned', []))
        && (request.auth.uid in request.resource.data.participants)
        && request.resource.data.participants.toSet()
             .difference(resource.data.participants.toSet()).hasOnly([request.auth.uid])
        && resource.data.participants.toSet()
             .difference(request.resource.data.participants.toSet()).size() == 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participants', 'metadata', 'unreadCount'])
        && (
          resource.data.get('requireInvite', false) != true
          || (
            request.resource.data.metadata[request.auth.uid].via is string
            && exists(/databases/$(database)/documents/group_invites/$(request.resource.data.metadata[request.auth.uid].via))
            && get(/databases/$(database)/documents/group_invites/$(request.resource.data.metadata[request.auth.uid].via)).data.chatId == convoId
          )
        );
      allow delete: if false;

      // Join requests for PRIVATE groups. Doc id = requester uid. The requester
      // creates/cancels their own; admins (and the creator) read + delete on
      // approve/deny. Approval itself is the admin adding the uid to
      // participants via the base update rule above.
      match /joinRequests/{reqUid} {
        function convo() { return get(/databases/$(database)/documents/conversations/$(convoId)).data; }
        function isGroupAdmin() {
          return isAuth() && (
            request.auth.uid in convo().admins
            || convo().createdBy == request.auth.uid
          );
        }
        allow read: if isAuth() && (reqUid == request.auth.uid || isGroupAdmin());
        // Same two gates as public self-join: banned users can't even ask, and
        // once an invite code is required the requester must present a live one.
        allow create: if isAuth() && reqUid == request.auth.uid
          && !(request.auth.uid in convo().participants)
          && !(request.auth.uid in convo().get('banned', []))
          && (
            convo().get('requireInvite', false) != true
            || (
              request.resource.data.via is string
              && exists(/databases/$(database)/documents/group_invites/$(request.resource.data.via))
              && get(/databases/$(database)/documents/group_invites/$(request.resource.data.via)).data.chatId == convoId
            )
          );
        allow delete: if isAuth() && (reqUid == request.auth.uid || isGroupAdmin());
      }

      // The group's CURRENT invite code, readable only by its admins (the
      // conversation doc itself is world-readable to signed-in users, so the
      // code cannot be kept there — see the self-join rule above).
      match /groupInvite/{docId} {
        function convo() { return get(/databases/$(database)/documents/conversations/$(convoId)).data; }
        allow read, write: if isAuth() && (
          request.auth.uid in convo().admins || convo().createdBy == request.auth.uid
        );
      }

      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        // ⚠ SECURITY: this used to be `senderId == request.auth.uid` and NOTHING
        // else. Owning the senderId proves who you are, not that you belong in
        // the thread, so ANY signed-in account could write a message into ANY
        // conversation on the platform. Read, update and delete all check
        // membership on the line above and below; create did not.
        //
        // It is trivially targetable, by this file's own admission 120 lines up:
        // a DM id is "the two uids sorted and joined with '_'" and uids are
        // enumerable because /users is world-read. So it was an unsolicited-DM
        // and harassment vector that bypassed blocks, privacy tiers and the
        // stranger-media gate, because none of those are enforced here.
        //
        // The squad equivalent (line ~447) has always required isSquadMember,
        // so this was an oversight rather than a deliberate asymmetry.
        //
        // Cost: one get() per message CREATE. Read/update/delete already pay the
        // same get(), and creates are far rarer than reads. `sendMessage` only
        // ever batch.update()s the conversation, and `createConversation`
        // awaits its setDoc separately, so the parent doc always exists by the
        // time a message is written and this get() cannot spuriously fail.
        allow create: if isAuth()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow update: if isAuth() && (
          resource.data.senderId == request.auth.uid ||
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'read', 'readAt']))
        );
        allow delete: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }

      match /typing/{docId} {
        allow read, write: if isAuth() && (
          (exists(/databases/$(database)/documents/conversations/$(convoId)) &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants) ||
          !exists(/databases/$(database)/documents/conversations/$(convoId))
        );
      }

      // Content-free op sync for the relay chat path (reactions + delete
      // tombstones — msg ids, emoji and uids only, never message text).
      match /meta/{docId} {
        allow read, write: if isConversationParticipant(convoId);
      }
    }

    // ============================================================
    // CALLS
    // ============================================================

    // Voice channels (Discord-style rooms). No explicit rules existed before
    // (default deny). Owner manages; any signed-in user may update ONLY the
    // `active` presence map (join/leave/heartbeat written by voiceSession).
    match /voice_channels/{channelId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
      );
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Call history — one doc per finished call, participants-gated.
    match /calls_history/{entryId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    // A call doc holds both WebRTC session descriptions. This app uses
    // NON-TRICKLE ICE, so the host/srflx candidates — which carry IP
    // ADDRESSES — are embedded in the SDP on this document, not in the
    // candidate subcollections (verified on a live call 2026-08-18: both
    // subcollections were empty while offer+answer were present).
    //
    // The whole block used to be a bare isAuth(), which meant: enumerate every
    // call on the platform and read who called whom plus both SDPs (the
    // enumeration half was confirmed live); write your own `answer` before the
    // real callee and have the caller negotiate with YOU; and end or forge any
    // call. `calls_history` directly above already had the right shape.
    match /calls/{callId} {
      allow get: if isAuth() && request.auth.uid in resource.data.participants;
      // NOT `if false`. IncomingCallManager subscribes with
      // where('participants','array-contains',me) + where('status','==','ringing'),
      // which is a LIST and is evaluated against THIS rule, not `get` — denying
      // list outright would stop every incoming call from ringing. Gating list
      // on the same participant condition is what closes enumeration: an
      // unconstrained getDocs(collection('calls')) cannot satisfy it.
      allow list: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.callerId == request.auth.uid;
      allow update: if isAuth() && (
        // Signalling on a live call: you must ALREADY be a participant of this
        // exact call. This is what blocks the answer-injection hijack.
        (request.auth.uid in resource.data.participants
         && request.auth.uid in request.resource.data.participants)
        // Starting a NEW call on the same doc. The id is the stable chat id, so
        // every call between the same people reuses one document and the client
        // setDoc()s it whole. For a group that rewrites the roster, so a member
        // who joined since the last call is not in resource.data.participants
        // yet and would otherwise be unable to start one. Only allowed once the
        // previous call is over, and only naming yourself as the caller.
        || (resource.data.get('status', 'ended') == 'ended'
            && request.resource.data.callerId == request.auth.uid
            && request.auth.uid in request.resource.data.participants)
      );
      allow delete: if false;

      // Gated on the parent call's participants. `write` (not read/create) is
      // deliberate: webrtc.js deletes these on teardown.
      match /callerCandidates/{candidateId} {
        allow read, write: if isAuth() && request.auth.uid in
          get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if isAuth() && request.auth.uid in
          get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow create: if false;
    }

    // ============================================================
    // OFFICIAL CHANNELS (admin-to-user broadcast threads)
    // ============================================================
    // Vergr's own accounts appear in the message list as chats. ONE shared
    // channel doc and ONE shared messages subcollection serve every user, so a
    // send costs one write no matter how many users there are. Per-user state
    // (read / mute / clear / delete) lives in channel_state/{uid}.
    //
    // Consequence of the shared model, and the reason nothing personal may ever
    // be posted to a channel: these messages are world-readable. Anything
    // per-user has to be a notification or a real DM.

    // Two visibility modes, and the difference is REAL, not cosmetic:
    //
    //   restricted != true  → an OPEN channel. The doc and its messages are
    //     world-readable. A `visibility.segment` on an open channel is a SOFT
    //     render filter (curation: "this is aimed at creators"), never secrecy.
    //
    //   restricted == true  → a CLOSED channel. Rules enforce membership on both
    //     the channel doc and its messages, so a non-member cannot read the
    //     content, the preview, or even learn the channel exists. Membership is a
    //     tiny doc per member, written server-side only.
    //
    // Anything that must actually be private has to be a closed channel. Putting
    // it in an open one with a segment set is a filter, not a lock.
    // Campaigns. ONE shared document per announcement, read by every client, so
    // a campaign to the whole platform costs the reads of a single doc. Only
    // SENT campaigns are readable: a draft is unfinished work and must not leak
    // before it goes out.
    //
    // The segment on a campaign is applied client-side and is CURATION, not
    // secrecy. Anything genuinely private belongs in a restricted channel, which
    // is gated above by real membership.
    // Transactional email templates. Server-only: these decide what a password
    // reset says, so a client that could write them could phish every user.
    match /email_templates/{templateId} {
      allow read, write: if false;
      match /versions/{v} { allow read, write: if false; }
    }
    // Coin sale promos. Read by nobody directly: the store asks
    // getActiveCoinPromo, which is what stops a client from reading a promo
    // that is scheduled but not live, or computing its own bonus.
    match /coin_promos/{promoId} {
      allow read, write: if false;
    }
    // Redemption records exist to make the cap and the idempotency provable.
    // Server-written only; a client that could touch these could mint bonuses.
    match /promo_redemptions/{id} {
      allow read, write: if false;
    }
    match /announcements/{campaignId} {
      allow read: if isAuth() && resource.data.status == 'sent';
      allow write: if false; // adminUpsertCampaign / adminSendCampaign only
    }

    // Per-user engagement with a campaign. Owner-written because the client is
    // what knows an impression happened, but the id is bound to the caller's uid
    // so nobody can write a read receipt on someone else's behalf, and the
    // aggregate counters live on the campaign doc, which stays server-only.
    match /announcement_reads/{readId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && readId.split('__')[1] == request.auth.uid;
      allow delete: if false;
    }

    match /official_channels/{channelId} {
      allow read: if resource.data.restricted != true
        || (isAuth() && exists(/databases/$(database)/documents/official_channels/$(channelId)/members/$(request.auth.uid)));
      // Server only. Written by adminUpsertChannel / adminSendChannelMessage.
      allow write: if false;

      match /messages/{messageId} {
        allow read: if get(/databases/$(database)/documents/official_channels/$(channelId)).data.restricted != true
          || (isAuth() && exists(/databases/$(database)/documents/official_channels/$(channelId)/members/$(request.auth.uid)));
        allow write: if false;
      }

      // Membership for closed channels. A member may confirm their own row, which
      // is what lets the client resolve a closed channel it belongs to.
      match /members/{memberUid} {
        allow read: if isOwner(memberUid);
        allow write: if false;
      }
    }

    // Per-user index of the CLOSED channels this user belongs to.
    //
    // Needed because a broad query for closed channels can never satisfy a
    // membership rule (Firestore requires a query to be provably allowed for the
    // whole result set, so it would be denied outright). The client reads this
    // list and fetches those channels by id instead. Server-written.
    match /channel_members/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Per-user channel state. One doc per user holding every channel's state, so
    // the client reads it once on app open. Deliberately NOT a map keyed by uid
    // on the channel doc: that would have every user writing one shared document.
    //
    // There is NO unsubscribe field, by design (founder decision D1). A user can
    // mute, clear or delete their view of a channel; they cannot stop delivery.
    match /channel_state/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['channels', 'updatedAt']);
      allow delete: if false;
    }

    // ============================================================
    // SHOP / E‑COMMERCE
    // ============================================================

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if isOwner(resource.data.authorId);
        allow delete: if isOwner(resource.data.authorId) || isModerator();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin()
        );
        allow write: if false;
      }
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);

      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /wishlists/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);

      match /items/{itemId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // ============================================================
    // WALLET / COIN ECONOMY
    // ============================================================

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // Server-only fields cannot be written from the client.
      //
      // As of 2026-08-16 EVERY money field is on this list. What the owner may
      // still write is preferences carried on the wallet doc for convenience
      // (chatBackground and friends). If you are adding a field that represents
      // value, it belongs here, and the write belongs in a Cloud Function.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'usdcBalance', 'usdcPending',
          'kycLevel', 'kycStatus',
          'onboardingCompleted',
          'totpEnrolled',
          'walletFrozen', 'walletFrozenAt', 'walletFrozenReason',
          'whitelistedAddresses',
          'withdrawalLimits',
          'pinFailedAttempts', 'pinLockedUntil', 'pinLastFailedAt',
          // Revenue-share accrual, server-only. `owedMicroUsd` IS the payable
          // that functions/creatorPayouts.js pays out; the rest are the lifetime
          // aggregates the Earnings screen and the rate ladder read. None has a
          // legitimate client writer: every increment comes from coinLedger.js
          // through the Admin SDK. Left owner-writable, a client could mint the
          // liability Vergr owes it.
          //
          // The old `gems` / `totalGemsEarned` names are kept in this list on
          // purpose. The unit was removed on 2026-08-16, and a stale client
          // holding the old field name must not be able to write it either.
          // Stream Boost tokens, granted by the VP ladder (syncVpLevel) and
          // spent in createStreamSession INSTEAD of 50 coins. That makes them
          // worth exactly 50 coins each, so an owner-writable copy is a coin
          // printer. Server-only from the moment they existed.
          'boostTokens',
          // The typed boost INVENTORY that replaced the flat count above.
          // Each entry is worth its coin price, so an owner-writable map is a
          // coin printer with extra steps. Written only by purchaseBoostPack
          // and applyBoost, and by syncVpLevel for the ladder grants.
          'boosts',
          // Milestone counters, written only by claimDailyReward. Badges are
          // evaluated client-side from these, so owner-writable would turn
          // every loyalty badge into a self-declaration.
          'consecutiveDays', 'bestConsecutiveDays', 'distinctDaysActive',
          'owedMicroUsd', 'totalOwedMicroUsd', 'totalPaidMicroUsd',
          'earnedBalance', 'totalEarnedCoinsGross',
          'gems', 'totalGemsEarned', 'totalPaidOut', 'gemsInEscrow',
          // COINS AND VP, server-only since 2026-08-16.
          //
          // These were the last owner-writable money fields, left open because
          // three legacy helpers in src/firebase/firestore.js wrote them from
          // the browser (awardVP, recordAdWatch, contributeToSquad) plus seven
          // dead ones nothing called. All ten are gone: the three live paths
          // are now callables in functions/walletActions.js and the dead ones
          // were deleted.
          //
          // `balance` matters as much as the payable. Self-minted coins buy
          // real things, and a tip funded by minted coins accrues a real
          // revenue-share liability against Vergr, so leaving it writable was a
          // way to manufacture the payable indirectly.
          'balance', 'vp', 'totalEarned', 'totalSpent',
          'totalReceived', 'totalTipped'
        ]);
      allow delete: if false;

      match /daily_caps/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Sensitive wallet credentials. Server-only read AND write. Never
      // exposed to clients. Holds: pinHash, pinSalt, totpSecret (encrypted),
      // totpRecoveryCodesHashed. Anything that a malicious client could
      // grind offline goes here, not on the parent doc.
      match /security/{docId} {
        allow read, write: if false;
      }
    }

    // User-facing withdrawal requests. Owner can READ their own (to see
    // status timeline). All writes go through server callables which
    // enforce limits + KYC + lockout + audit.
    match /payout_requests/{requestId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Deposits that arrived without a valid PayRam refId or `vergr:{uid}` memo.
    // Admin queue for manual reconciliation. Owner of the deposit can't see
    // this — they file a support ticket and admin matches it up.
    match /unattributed_deposits/{depositId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Idempotency table for Circle Wallets inbound deposits. One doc per
    // Circle transaction id. Server-only (written by circleWalletsWebhook
    // and pollCircleDeposits in functions/circleWallets.js). Admin-readable
    // for reconciliation; users never need to see these directly.
    match /circle_deposits/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PayRam onramp orders — created by the PayRam handler (separate session)
    // when a user starts a coin-pack purchase. circleWalletsWebhook reads this
    // to map an inbound Circle deposit back to the buying user. The user can
    // see their own pending orders; only the server writes.
    match /payram_orders/{orderId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow write: if false;
    }

    // Daily wallet operations log. Tracks outflow totals for rate-limit
    // enforcement in processReadyWithdrawals + reconciliation drift
    // detection. Admin-readable, server-only writes.
    match /wallet_op_log/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /quest_claims/{claimId} {
      allow read: if isAuth();
      allow create, update, delete: if false;
    }

    // Email verification codes — Cloud-Functions-only. The (hashed) code must
    // never be client-readable, and only the CF may write/clear it.
    match /email_verifications/{uid} {
      allow read, write: if false;
    }

    // ============================================================
    // BOOSTS, STATUSES, etc.
    // ============================================================

    match /boosts/{boostId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /statuses/{statusId} {
      // Followers-only by default (matches the product promise + help docs). A
      // status is readable by its author, by anyone when it's explicitly
      // `audience == 'public'`, or by a viewer who FOLLOWS the author (a
      // `follows/{viewer}_{author}` doc exists). This is real enforcement — a
      // non-follower cannot read a followers-only status even by crafting a
      // query. Legacy statuses (no `audience` field) fall to followers-only.
      allow read: if isAuth() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.audience == 'public' ||
        exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.authorId))
      );
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerIds', 'viewCount'])
      );
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    match /users/{userId}/call_favourites/{favId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Global transactions
    match /transactions/{txId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      // Server-only, like every other money collection here. `create` only
      // ever checked that userId matched the caller — nothing constrained
      // `type`, `amount`, `currency` or the `earning` flag, so any account
      // could write itself a tip_received row. That matters because the
      // Earnings screen was deliberately moved onto the LEDGER rather than the
      // wallet aggregate, on the grounds that a ledger is auditable line by
      // line. That only holds if the ledger is server-written.
      //
      // Payouts were never at risk: creatorPayouts pays from
      // wallets.owedMicroUsd and the share tier keys off totalEarnedCoinsGross,
      // both already server-only. What was at risk is the audit trail.
      //
      // Nothing live writes this from src/. BoostScreen.jsx:75 does, but its
      // wallet debit two statements earlier already hits the server-only
      // denylist and throws, so the ledger row is unreachable (A31). The two
      // writers in firestore.js (finalizeTournament, recordModeratorPayout) are
      // tournament-era dead code whose userId is a DIFFERENT user, so they
      // could never satisfy even the old rule. When A31 rewrites the boost
      // purchase as a callable, its ledger row goes in that transaction.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Referral revenue-share dedupe markers — server-written only (Cloud
    // Functions admin SDK bypasses these). No client access.
    match /referral_purchase_bonuses/{sourceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /coin_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Top-level payouts (NOWPayments crypto withdrawals) ─────────
    // Server-only writes (Cloud Functions via admin SDK bypass these rules).
    // Users read their own payouts for the history screen.
    match /payouts/{payoutId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Coin purchases (NOWPayments invoices) ──────────────────────
    match /purchases/{orderId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Payout rate quotes (60-second TTL) ────────────────────────
    // Quotes are server-issued and consumed; clients should never write here.
    match /payout_quotes/{quoteId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Server cache (NOWPayments currency list etc.) ─────────────
    match /cache/{key} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Per-user rate-limit counters (Phase 4 anti-abuse) ─────────
    // Only the owning user can read their own counters; writes are
    // server-only via Cloud Functions.
    match /rate_limits/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ── Platform-side commission ledger (admin-only read) ─────────
    match /platform_commissions/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /platform_ledger/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Idempotency keys (server-side guard against double-charge) ─
    match /idempotency/{key} {
      allow read: if false;
      allow write: if false;
    }

    match /tips/{tipId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Event tickets (ticketed-tournament spectator passes). All money movement
    // runs server-side in purchaseEventTicket — clients never write these.
    match /event_tickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // Paid access to content: locked posts, locked chat media, paid streams.
    // Written ONLY by purchaseAccess, inside the wallet transaction.
    //
    // `allow write: if false` is the entire enforcement. The doc id is
    // deterministic (`{type}_{id}_{buyerUid}`), so a client that could write here
    // would simply mint itself the entitlement for anything at zero cost. Reads
    // are buyer and seller only: an unlock is a purchase record, and who bought
    // what is not public.
    match /entitlements/{entitlementId} {
      allow read: if isAuth() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // vergr.me digital product purchases. CF-write only (purchaseVergrMeProduct);
    // buyer + seller read their own rows.
    match /vergrme_purchases/{purchaseId} {
      allow read: if isAuth() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // vergr.me PHYSICAL product orders (carry the buyer's shipping address =
    // PII, so reads are strictly buyer/seller/admin). Created by CF only.
    // The seller's ONLY direct write is marking a placed order shipped
    // (+ an optional tracking note) — cancellation moves money, so it goes
    // through cancelVergrMeOrder.
    match /vergrme_orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuth()
        && resource.data.sellerUid == request.auth.uid
        && resource.data.status == 'placed'
        && request.resource.data.status == 'shipped'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'trackingNote', 'shippedAtMs']);
      allow create, delete: if false;
    }

    // Vergr Shop connected-store registry (which sellers have a Shopify/Woo
    // integration). CF-only — written by connectShopIntegration, read by the
    // daily reconcile. Holds no secrets, but no client needs it.
    match /shop_connected/{uid} {
      allow read, write: if false;
    }

    // Shopify PUBLIC app (Vergr Link In Bio). shopify_shops holds the RAW
    // Shopify Admin access token per installed shop, so it is server-only and
    // must stay that way — a callable returns a safe view if a client ever
    // needs one. The other three are OAuth nonces, GDPR erasure evidence and
    // a webhook log; none of them has a client reader.
    match /shopify_shops/{shopDomain} {
      allow read, write: if false;
    }
    // One-time codes binding a Shopify store to a Vergr account. Server-only:
    // the code IS the authorisation, so a client able to read this collection
    // could claim any pending store.
    match /shopify_connect_codes/{code} {
      allow read, write: if false;
    }

    match /shopify_oauth_states/{nonce} {
      allow read, write: if false;
    }
    match /shopify_erasures/{docId} {
      allow read, write: if false;
    }
    match /shopify_webhook_log/{docId} {
      allow read, write: if false;
    }

    // Season passes (host-level access to all their ticketed events).
    // Written only by purchaseSeasonPass.
    match /event_season_passes/{passId} {
      allow read: if isAuth() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // ============================================================
    // CREATORS, MEMBERSHIPS, STREAMS, TOURNAMENTS
    // ============================================================

    match /creators/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /analytics/{period} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /payouts/{payoutId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /memberships/{membershipId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuth() && resource.data.creatorId == request.auth.uid;
      allow delete: if isAuth() && resource.data.creatorId == request.auth.uid;
    }

    match /member_subscriptions/{subId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Chat polls (DM/group message polls). The poll body is a top-level doc
    // because relay-stored DM messages can't persist nested data; the chat
    // message carries only the poll id. Membership of the conversation gates
    // everything; votes are strictly own-doc writes so one user can never
    // touch another's vote. Squad chat has its own inline poll system and
    // does NOT use this collection.
    match /chat_polls/{pollId} {
      function pollConvOf(data) {
        return get(/databases/$(database)/documents/conversations/$(data.convId)).data;
      }
      function isPollMember(data) {
        return data.scope == 'dm'
          && data.convId is string
          && request.auth.uid in pollConvOf(data).participants;
      }
      allow read: if isAuth() && (isPollMember(resource.data) || isAdmin());
      allow create: if isAuth()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 6
        && isPollMember(request.resource.data);
      allow update: if false;
      allow delete: if isAuth() && resource.data.creatorUid == request.auth.uid;

      match /votes/{voterUid} {
        allow read: if isAuth() && (
          isPollMember(get(/databases/$(database)/documents/chat_polls/$(pollId)).data) || isAdmin()
        );
        allow create, update: if isAuth()
          && voterUid == request.auth.uid
          && request.resource.data.picks is list
          && request.resource.data.picks.size() <= 6
          && isPollMember(get(/databases/$(database)/documents/chat_polls/$(pollId)).data);
        allow delete: if isAuth() && voterUid == request.auth.uid;
      }
    }

    // Scheduled messages (Lite/Pro). Created only by the scheduleMessage CF
    // (tier gate), executed by the relay. The owner can read + cancel (delete)
    // their own pending ones; no client create/update.
    match /scheduled_messages/{schedId} {
      allow read: if isAuth() && resource.data.senderUid == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if isAuth() && resource.data.senderUid == request.auth.uid;
    }

    // Community-import jobs (Discord Phase 2 / WhatsApp export → relay store).
    // CF-created + box-worker-updated only; the requester may READ their job
    // for the progress UI. No client writes ever (a client-writable queue doc
    // would let anyone import into any group).
    match /community_imports/{importId} {
      allow read: if isAuth() && resource.data.requestedBy == request.auth.uid;
      allow write: if false;
    }

    // Publish credentials, keyed BY the credential so vergr-rtmp-auth resolves
    // one with a document get. Denied to every client without exception: the
    // stream key is what authorises publishing to a broadcast (browser ingest
    // sends it as a Bearer token, OBS types it in), and it is also the path
    // segment in the HLS playback URL, so a reader of one could both hijack the
    // broadcast and walk straight past a paid stream's paywall. It used to be a
    // field on the world-readable stream document below, which is exactly the
    // problem this collection exists to fix. Do not add a read rule here.
    match /stream_keys/{streamKey} {
      allow read, write: if false;
    }

    match /streams/{streamId} {
      allow read: if true;

      // A PAID stream's playback URLs live here rather than on the document
      // above, precisely because the document above is world-readable. Denying
      // clients entirely is the enforcement: getAccess (Admin SDK, bypasses
      // rules) hands the URL over after checking the entitlement.
      //
      // This must stay `if false`. Allowing the host to read their own would be
      // harmless; allowing anything broader hands the stream away for free.
      match /private/{docId} {
        allow read, write: if false;
      }
      // Two creation paths: the legacy client `createStream` sets streamerId;
      // the live-streaming `createStreamSession` Cloud Function (admin SDK,
      // bypasses rules) sets hostUid. So owner checks must accept EITHER field —
      // keying only on streamerId silently denied every non-admin host's own
      // updates (status/metadata/lastHeartbeat), which broke the stale-stream
      // heartbeat (admins bypassed via isModerator, hiding the bug).
      allow create: if isAuth() && (
        request.resource.data.streamerId == request.auth.uid ||
        request.resource.data.hostUid == request.auth.uid
      );
      // ⚠⚠ `hypeTrain` IS SERVER-ONLY, AND WITHOUT THIS IT IS A COIN PRINTER.
      // The branch below grants the host write on ANY field of their own stream
      // doc, and the bonus is computed from `hypeTrain.received`: a host could
      // stamp `{received: 25000, level: 5}` on their own stream, end it, and
      // collect the capped 5,000 coins for a train nobody rode. Written only by
      // sendTip and endStreamSession, both of which derive it from tips that
      // were actually paid.
      //
      // `peakViewers` and `viewerCount` join it for the same reason at a
      // smaller scale: they are written by the Go relay's presence loop and are
      // shown to viewers as fact.
      //
      // Same lock, same reasoning, as boostExpiresAt on posts and squads.
      allow update: if (isOwner(resource.data.streamerId) || isOwner(resource.data.hostUid) || isModerator())
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['hypeTrain', 'peakViewers', 'viewerCount']);
      allow delete: if isOwner(resource.data.streamerId) || isOwner(resource.data.hostUid) || isModerator();

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isOwner(resource.data.authorId) || isModerator();
      }

      match /drops/{dropId} {
        allow read: if true;
        allow write: if isOwner(resource.data.streamerId);
      }

      // Join announcements (JoinAnnouncer entry ribbons).
      //
      // CREATE IS SERVER-ONLY as of 2026-08-23. It used to be `isAuth() &&
      // uid == request.auth.uid`, which validated ONLY the uid: every other
      // field was whatever the client sent. That let any signed-in account
      // write `kind:'subscriber', tier:'pro'` into ANY stream to get the gold
      // entrance without subscribing, spam unlimited join docs into a stream it
      // did not own (announcement spam plus a write-cost attack), and supply an
      // arbitrary display name and avatar. Now that the entrance is keyed to VP
      // rank, that would have meant "anyone can be Immortal in anyone's room".
      // `announceStreamJoin` (functions/streamJoins.js) resolves follower state,
      // subscription tier and rank server-side and owns dedupe, rate limiting
      // and block suppression. See docs/ENTRY_ANNOUNCEMENTS_SPEC.md.
      match /joins/{joinId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if isModerator() || isOwner(resource.data.uid);
      }

      // Per-user announce dedupe and the per-stream rate window. Server-owned.
      match /joinLocks/{lockId} {
        allow read: if false;
        allow write: if false;
      }
      match /meta/{metaId} {
        allow read: if false;
        allow write: if false;
      }

      // Vanguard presence — written when a Vanguard viewer mounts the
      // stream screen, so other viewers can see a "Vanguard has joined"
      // banner + persistent badge. Anyone can read (so the banner fires
      // for all viewers). The Vanguard themselves write their OWN doc.
      // Commander+ can delete ANY doc in the same stream (remove a mod).
      match /vanguardPresence/{vanguardUid} {
        allow read: if true;
        allow create, update: if isAuth()
          && request.auth.uid == vanguardUid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vanguard.rank in ['recruit', 'vanguard', 'senior', 'commander', 'overseer'];
        allow delete: if isAuth() && (
          request.auth.uid == vanguardUid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vanguard.rank in ['commander', 'overseer'] ||
          isAdmin()
        );
      }

      // Top-gifters leaderboard. The sendTip callable (Admin SDK) accumulates
      // each gifter's per-stream coin total here; everyone watching reads the
      // ranking. Server-written only so the board can't be spoofed.
      match /gifters/{gifterUid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Schedule-ahead live streams. The host creates/edits their own scheduled
    // doc from Go Live; the notifyScheduledStreams cron (Admin SDK) flips status
    // + sends reminders. Public-readable for an "Upcoming" discovery surface.
    match /scheduled_streams/{schedId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if (isAuth() && resource.data.hostUid == request.auth.uid) || isAdmin();
    }

    // GR5 — brawl matchmaking queue. Reads allowed (a player polls their own
    // entry for the matched tournament); all writes go through callables.
    match /brawl_queue/{queueId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Creator payouts (revenue share) ──────────────────────────────
    // All three are written ONLY by functions/creatorPayouts.js. A client that
    // could write any of them could grant itself a payout, change its own
    // cadence, or mark an unpaid statement paid, so every write is `false`
    // rather than a validated rule: there is no legitimate client write here.

    // A creator sees their own payout setup (cadence, tax-form status, strikes)
    // because the Earnings screen has to explain why they are or are not
    // getting paid. Nobody else can see it: strikes are moderation data.
    match /payout_accounts/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Run totals are platform financials, admin only.
    match /payout_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A statement is the creator's remittance advice and their tax record, so
    // they must be able to read their own. Doc id is `{runId}__{uid}`, which is
    // not something a rule can parse reliably, so ownership is checked against
    // the `uid` field written into the doc by the payout run.
    match /payout_statements/{statementId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Solvency ledger: aggregate platform financials. Admin only, server-written.
    match /platform_ledger/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /platform_ledger_daily/{dayKey} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /solvency_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /tournaments/{tourneyId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.organizerId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.organizerId == request.auth.uid
        );
        allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      }

      match /brackets/{bracketId} {
        allow read: if true;
        allow write: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.organizerId == request.auth.uid || isAdmin()
        );
      }

      match /matches/{matchId} {
        allow read: if true;
        allow create, update: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.adminId == request.auth.uid || isAdmin()
        );
        allow delete: if isAdmin();

        // IM1 — per-match opponent chat. Only the two match participants may
        // post (their own senderUid); anyone may read (mods/dispute trail).
        // History is immutable to participants; mods/admin can prune.
        match /chat/{msgId} {
          allow read: if true;
          allow create: if isAuth()
            && request.resource.data.senderUid == request.auth.uid
            && (
              request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tourneyId)/matches/$(matchId)).data.player1 ||
              request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tourneyId)/matches/$(matchId)).data.player2 ||
              isAdmin()
            );
          allow update, delete: if isAdmin();
        }
      }

      // Vanguard presence in tournaments — same shape as stream presence.
      match /vanguardPresence/{vanguardUid} {
        allow read: if true;
        allow create, update: if isAuth()
          && request.auth.uid == vanguardUid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vanguard.rank in ['recruit', 'vanguard', 'senior', 'commander', 'overseer'];
        allow delete: if isAuth() && (
          request.auth.uid == vanguardUid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vanguard.rank in ['commander', 'overseer'] ||
          isAdmin()
        );
      }
    }

    // ============================================================
    // REPORTS / MODERATION
    // ============================================================

    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      // Vanguard members ARE the report queue audience (they approve/reject/
      // escalate via the vanguardResolveReport callable, which runs server-side
      // and bypasses rules), but accepting a Vanguard invite sets vanguard.rank,
      // not role:'moderator' — so READ must include isVanguardMember() or the
      // queue is invisible to them. Writes stay server-side only.
      allow read: if isModerator() || isVanguardMember();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /mod_actions/{actionId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /banned_words/{docId} {
      allow read: if isModerator();
      allow write: if isAdmin();
    }

    // ============================================================
    // ADS, NEWS, HASHTAGS, LEADERBOARDS, FEEDBACK
    // ============================================================

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();

      match /impressions/{impId} {
        allow read: if isAdmin();
        allow create: if isAuth();
      }
      match /clicks/{clickId} {
        allow read: if isAdmin();
        allow create: if isAuth();
      }
    }

    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hashtags/{tag} {
      allow read: if true;
      allow write: if false;
    }

    match /trending/{period} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // KYC — VERIFICATION APPLICATIONS
    // Owner can create their own app & read status. Full PII lives in the
    // /private/pii subdoc — admin/moderator only. Cloud Functions (admin SDK)
    // bypass all rules and handle decisions + cleanup.
    // ═══════════════════════════════════════════
    match /verification_applications/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == uid;
      allow read:   if isOwner(uid) || isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();

      match /private/{docId} {
        // Owner can write their encrypted PII doc; they cannot read it back.
        allow create: if isOwner(uid);
        allow read, update, delete: if isModerator();
      }
    }

    // Short-lived desktop→mobile handoff sessions (30-min TTL)
    match /verification_sessions/{sid} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Append-only audit log of KYC reviewer actions
    match /kyc_audit_log/{eventId} {
      allow read:  if isAdmin();
      allow write: if false; // functions only
    }

    // ── Profit ledger (functions/platformRevenue.js) ────────────────────
    // Every line of platform margin: what a sale grossed, what the rails took,
    // what liability it accrued, what a sink released. Admin-readable so the
    // economy screen can show it; NEVER client-writable, because a wallet that
    // can write its own revenue row is not a ledger.
    //
    // Nothing here is per-user data a user is entitled to see: `uid` is on the
    // rows only so a figure can be traced back, and exposing them would leak
    // other people's purchase amounts through the daily rollups.
    match /platform_revenue/{rowId} {
      allow read:  if isAdmin();
      allow write: if false; // functions only
    }
    match /platform_revenue_daily/{dayKey} {
      allow read:  if isAdmin();
      allow write: if false; // functions only
    }

    // ── Adaptive video transcode queue (infra/transcode/worker.js) ──────
    // Written by Cloud Functions, claimed and completed by the worker boxes
    // using the Admin SDK, which bypasses rules entirely. No client has any
    // reason to see or touch this: a client that could write here could point
    // a transcode job at an arbitrary URL and make our boxes fetch it.
    match /transcode_jobs/{jobId} {
      allow read:  if isAdmin();
      allow write: if false; // functions + admin-SDK workers only
    }
  }
}