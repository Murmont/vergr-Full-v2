rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS (now inside the match, so they can use $(database))
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isModerator() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function isSquadMember(squadId) {
      return isAuth() && exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid));
    }

    function isSquadAdmin(squadId) {
      return isAuth() && get(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid)).data.role in ['president', 'vice_president'];
    }

    function isSquadOwner(squadId) {
      return isAuth() && get(/databases/$(database)/documents/squads/$(squadId)).data.ownerId == request.auth.uid;
    }

    function validString(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }

    function isConversationParticipant(convoId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
    }

    // ============================================================
    // APP CONFIG
    // ============================================================

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        // Block self-referral on initial doc create
        && (!('referredBy' in request.resource.data) || request.resource.data.referredBy != userId);
      allow update: if (isOwner(userId) && (
          // referredBy is write-once: either it didn't exist before, or it's unchanged
          !('referredBy' in resource.data) || resource.data.referredBy == request.resource.data.get('referredBy', resource.data.referredBy)
        ) && (
          // Cannot self-refer
          !('referredBy' in request.resource.data) || request.resource.data.referredBy != userId
        ))
        || isModerator()
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followingCount']));
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /game_accounts/{accountId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /bookmarks/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Privacy/consent docs (consent banners, captureSignals telemetry).
      // Owner read/write; admins can read for support. Server (Cloud Functions)
      // bypasses these rules anyway via the admin SDK.
      match /meta/{docId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Saved crypto wallet addresses for fast payouts.
      match /savedAddresses/{addrId} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ============================================================
    // FOLLOWS
    // ============================================================

    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ============================================================
    // POSTS
    // ============================================================

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.authorId == request.auth.uid
        && validString('content', 5000);
      allow update: if isOwner(resource.data.authorId) || isModerator();
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid
          && validString('content', 2000);
        allow update: if isOwner(resource.data.authorId) || isModerator();
        allow delete: if isOwner(resource.data.authorId) || isModerator();
      }

      match /likes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /saves/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // ============================================================
    // POLLS
    // ============================================================

    match /polls/{pollId} {
      allow read: if true;
      allow create: if isAuth();

      match /votes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId);
      }
    }

    // ============================================================
    // STORIES
    // ============================================================

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      match /viewers/{viewerId} {
        allow read: if isOwner(resource.parent.data.authorId);
        allow create: if isAuth() && request.auth.uid == viewerId;
      }
    }

    // ============================================================
    // SQUADS
    // ============================================================

    match /squads/{squadId} {
      allow read: if true;
      allow create: if isAuth();

      allow update: if isSquadAdmin(squadId) || isModerator() || (
        get(/databases/$(database)/documents/squads/$(squadId)).data.isPublic == true &&
        request.auth.uid != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt']) &&
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if isSquadOwner(squadId) || isAdmin();

      match /members/{memberId} {
        allow read: if true;
        allow create: if isAuth() && (request.auth.uid == memberId || isSquadAdmin(squadId));
        allow update: if isAuth() && (request.auth.uid == memberId || isSquadAdmin(squadId));
        allow delete: if isAuth() && (request.auth.uid == memberId || isSquadAdmin(squadId));
      }

      match /messages/{messageId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isSquadMember(squadId);
        allow delete: if isAuth() && (resource.data.senderId == request.auth.uid || isSquadAdmin(squadId));
      }

      match /events/{eventId} {
        allow read: if true;
        allow write: if isSquadAdmin(squadId);
      }

      match /challenges/{challengeId} {
        allow read: if isSquadMember(squadId);
        allow write: if isSquadAdmin(squadId);
      }

      match /media/{mediaId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId) && request.resource.data.uploadedBy == request.auth.uid;
        allow delete: if isOwner(resource.data.uploadedBy) || isSquadAdmin(squadId);
      }

      match /join_requests/{requestId} {
        allow read: if isSquadAdmin(squadId);
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update: if isSquadAdmin(squadId);
        allow delete: if isSquadAdmin(squadId) || isOwner(resource.data.userId);
      }

      match /pinned/{pinnedId} {
        allow read: if isSquadMember(squadId);
        allow write: if isSquadAdmin(squadId);
      }

      // ✅ Votes subcollection – open to any authenticated user (for debugging)
      match /votes/{voteId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if false;
      }

      // ✅ Vote intents for /vote command
      match /vote_intents/{userId} {
        allow read: if isSquadMember(squadId);
        allow create, update, delete: if isAuth() && request.auth.uid == userId && isSquadMember(squadId);
      }

      match /wallet/{docId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId);
        allow update: if isSquadMember(squadId);
        allow write: if false;
      }

      match /transactions/{txId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadMember(squadId);
        allow update: if false;
        allow delete: if false;
      }

      match /announcements/{annId} {
        allow read: if isSquadMember(squadId);
        allow create: if isSquadAdmin(squadId);
        allow update: if isSquadAdmin(squadId);
        allow delete: if isSquadAdmin(squadId);
      }
    }

    // ============================================================
    // CONVERSATIONS (DIRECT MESSAGES)
    // ============================================================

    match /conversations/{convoId} {
      allow get: if isAuth();
      allow list: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth() && (
          resource.data.senderId == request.auth.uid ||
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'read', 'readAt']))
        );
        allow delete: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }

      match /typing/{docId} {
        allow read, write: if isAuth() && (
          (exists(/databases/$(database)/documents/conversations/$(convoId)) &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants) ||
          !exists(/databases/$(database)/documents/conversations/$(convoId))
        );
      }
    }

    // ============================================================
    // CALLS
    // ============================================================

    match /calls/{callId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read, write: if isAuth();
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if isAuth();
      }
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow create: if false;
    }

    // ============================================================
    // SHOP / E‑COMMERCE
    // ============================================================

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid;
        allow update: if isOwner(resource.data.authorId);
        allow delete: if isOwner(resource.data.authorId) || isModerator();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin()
        );
        allow write: if false;
      }
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);

      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /wishlists/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);

      match /items/{itemId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // ============================================================
    // WALLET / COIN ECONOMY
    // ============================================================

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /daily_caps/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /quest_claims/{claimId} {
      allow read: if isAuth();
      allow create, update, delete: if false;
    }

    // ============================================================
    // BOOSTS, STATUSES, etc.
    // ============================================================

    match /boosts/{boostId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /statuses/{statusId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerIds', 'viewCount'])
      );
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    match /users/{userId}/call_favourites/{favId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Global transactions
    match /transactions/{txId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /coin_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Top-level payouts (NOWPayments crypto withdrawals) ─────────
    // Server-only writes (Cloud Functions via admin SDK bypass these rules).
    // Users read their own payouts for the history screen.
    match /payouts/{payoutId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Coin purchases (NOWPayments invoices) ──────────────────────
    match /purchases/{orderId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Payout rate quotes (60-second TTL) ────────────────────────
    // Quotes are server-issued and consumed; clients should never write here.
    match /payout_quotes/{quoteId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Server cache (NOWPayments currency list etc.) ─────────────
    match /cache/{key} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Per-user rate-limit counters (Phase 4 anti-abuse) ─────────
    // Only the owning user can read their own counters; writes are
    // server-only via Cloud Functions.
    match /rate_limits/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ── Platform-side commission ledger (admin-only read) ─────────
    match /platform_commissions/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /platform_ledger/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Idempotency keys (server-side guard against double-charge) ─
    match /idempotency/{key} {
      allow read: if false;
      allow write: if false;
    }

    match /tips/{tipId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // CREATORS, MEMBERSHIPS, STREAMS, TOURNAMENTS
    // ============================================================

    match /creators/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /analytics/{period} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /payouts/{payoutId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /memberships/{membershipId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuth() && resource.data.creatorId == request.auth.uid;
      allow delete: if isAuth() && resource.data.creatorId == request.auth.uid;
    }

    match /member_subscriptions/{subId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /streams/{streamId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.streamerId == request.auth.uid;
      allow update: if isOwner(resource.data.streamerId) || isModerator();
      allow delete: if isOwner(resource.data.streamerId) || isModerator();

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isOwner(resource.data.authorId) || isModerator();
      }

      match /drops/{dropId} {
        allow read: if true;
        allow write: if isOwner(resource.data.streamerId);
      }
    }

    match /tournaments/{tourneyId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.organizerId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.organizerId == request.auth.uid
        );
        allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      }

      match /brackets/{bracketId} {
        allow read: if true;
        allow write: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.organizerId == request.auth.uid || isAdmin()
        );
      }

      match /matches/{matchId} {
        allow read: if true;
        allow create, update: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tourneyId)).data.adminId == request.auth.uid || isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // REPORTS / MODERATION
    // ============================================================

    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /mod_actions/{actionId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /banned_words/{docId} {
      allow read: if isModerator();
      allow write: if isAdmin();
    }

    // ============================================================
    // ADS, NEWS, HASHTAGS, LEADERBOARDS, FEEDBACK
    // ============================================================

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();

      match /impressions/{impId} {
        allow read: if isAdmin();
        allow create: if isAuth();
      }
      match /clicks/{clickId} {
        allow read: if isAdmin();
        allow create: if isAuth();
      }
    }

    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hashtags/{tag} {
      allow read: if true;
      allow write: if false;
    }

    match /trending/{period} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    // KYC — VERIFICATION APPLICATIONS
    // Owner can create their own app & read status. Full PII lives in the
    // /private/pii subdoc — admin/moderator only. Cloud Functions (admin SDK)
    // bypass all rules and handle decisions + cleanup.
    // ═══════════════════════════════════════════
    match /verification_applications/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == uid;
      allow read:   if isOwner(uid) || isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();

      match /private/{docId} {
        // Owner can write their encrypted PII doc; they cannot read it back.
        allow create: if isOwner(uid);
        allow read, update, delete: if isModerator();
      }
    }

    // Short-lived desktop→mobile handoff sessions (30-min TTL)
    match /verification_sessions/{sid} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Append-only audit log of KYC reviewer actions
    match /kyc_audit_log/{eventId} {
      allow read:  if isAdmin();
      allow write: if false; // functions only
    }
  }
}