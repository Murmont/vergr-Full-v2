[Unit]
Description=VERGR RTMP auth + bitrate watchdog
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=simple
ExecStart=/opt/vergr-rtmp-auth/vergr-rtmp-auth -listen 127.0.0.1:8093 -creds /etc/vergr-rtmp-auth/firebase-admin.json -stat http://127.0.0.1/rtmp-stat -control http://127.0.0.1/rtmp-control
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/vergr-rtmp-auth
PrivateTmp=true
MemoryMax=300M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
